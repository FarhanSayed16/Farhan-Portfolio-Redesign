# Vercel / Production Environment Variables

# EmailJS Configuration (Used in the ContactWindow component)
# Get these from your EmailJS dashboard: https://dashboard.emailjs.com/
NEXT_PUBLIC_EMAILJS_SERVICE_ID="your_service_id_here"
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID="your_template_id_here"
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY="your_public_key_here"

# Note: If these are not provided, the Contact Window will safely fallback 
# to a standard `mailto:` link opening the user's default email client.
